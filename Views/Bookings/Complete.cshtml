@model CompleteBookingRequest
@{
    ViewData["Title"] = "Complete Service";
    var parts = (SelectList)ViewBag.Parts;
}

<h2 class="mb-3">Complete service #@ViewBag.BookingId</h2>

<div asp-validation-summary="All" class="alert alert-danger"></div>

<form asp-action="Complete" asp-route-id="@ViewBag.BookingId" method="post" class="bg-white p-4 rounded shadow-sm" style="max-width: 760px;">
    <div class="mb-3" style="max-width: 260px;">
        <label asp-for="Mileage" class="form-label">Odometer reading (km)</label>
        <input asp-for="Mileage" type="number" min="0" class="form-control" />
        <span asp-validation-for="Mileage" class="text-danger small"></span>
    </div>

    <h5 class="mt-4">Parts used</h5>
    <p class="text-muted small">Leave rows empty if no parts were used. Stock is deducted when you complete the job.</p>
    @for (var i = 0; i < Model.Parts.Count; i++)
    {
        <div class="row g-2 mb-2">
            <div class="col-md-8">
                <select name="Parts[@i].PartId" class="form-select" asp-items="parts">
                    <option value="">-- none --</option>
                </select>
            </div>
            <div class="col-md-4">
                <input name="Parts[@i].Quantity" type="number" min="0" value="@Model.Parts[i].Quantity" class="form-control" placeholder="Qty" />
            </div>
        </div>
    }

    <div class="row mt-4" style="max-width: 360px;">
        <div class="col">
            <label asp-for="DiscountPercent" class="form-label">Discount %</label>
            <input asp-for="DiscountPercent" type="number" step="0.01" min="0" max="100" class="form-control" />
            <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success">Complete &amp; invoice</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
