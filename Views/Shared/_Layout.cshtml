<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vehicle Service Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">VSM</a>
        <div class="navbar-nav me-auto">
            @if (User.IsInRole("Admin") || User.IsInRole("Technician"))
            {
                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="Bookings" asp-action="Index">Bookings</a>
                <a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a>
                <a class="nav-link" asp-controller="Inventory" asp-action="Index">Parts</a>
                <a class="nav-link" asp-controller="Invoices" asp-action="Index">Invoices</a>
            }
            @if (User.IsInRole("Customer"))
            {
                <a class="nav-link" asp-controller="Portal" asp-action="Index">My services</a>
            }
        </div>
        <div class="navbar-nav">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="navbar-text me-3">@User.Identity.Name</span>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
                </form>
            }
            else
            {
                <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Log in</a>
            }
        </div>
    </div>
</nav>

<main class="container">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
